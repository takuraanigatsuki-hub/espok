<Files "config.local.php">
  Require all denied
</Files>

# API: собственная авторизация приложения, без HTTP Basic Auth
AuthType None
Require all granted

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=!SKIP_API_CACHE
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
