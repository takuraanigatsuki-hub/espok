{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epsok.gov.ru/schemas/horizon-mo-resonance.json",
  "title": "MOResonanceResult",
  "description": "MORM — сопоставление графа дела с MO-кластером",
  "type": "object",
  "required": ["id", "caseId", "moClusterId", "resonanceScore", "matchedPatterns", "createdAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "caseId": { "type": "string", "format": "uuid" },
    "moClusterId": { "type": "string", "pattern": "^MO-[0-9]+$" },
    "resonanceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "regionCount": { "type": "integer" },
    "caseCountInCluster": { "type": "integer" },
    "matchedPatterns": {
      "type": "array",
      "items": { "type": "string" },
      "examples": [["person→org→iban", "sim_reuse_cross_region"]]
    },
    "breakthroughRequestTypes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Типы запросов, дававшие breakthrough в похожих делах"
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
