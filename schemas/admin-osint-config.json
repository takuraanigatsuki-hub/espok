{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epsok.gov.ru/schemas/admin-osint-config.json",
  "title": "AdminOsintConfig",
  "description": "Конфигурация OSINT Worker Pool (OSW)",
  "type": "object",
  "required": ["workerReplicas", "moduleWhitelist", "updatedAt"],
  "properties": {
    "workerReplicas": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer" },
        "current": { "type": "integer" }
      }
    },
    "moduleWhitelist": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SpiderFoot module names — см. configs/osint-module-whitelist.yaml"
    },
    "proxyPolicy": { "type": "string", "enum": ["strict", "standard", "research"] },
    "maxScanDurationMinutes": { "type": "integer" },
    "ephemeralStorageGi": { "type": "integer" },
    "pendingApprovalDiff": { "type": "string", "description": "Diff whitelist, ожидающий второго согласования" },
    "updatedBy": { "type": "string", "format": "uuid" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
